# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/agreements"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
# Public URL of this app (no trailing slash)
NEXTAUTH_URL="https://agreements.hawaiidata.ai"

# ─── SendGrid ─────────────────────────────────────────────────────────────────
# Create an API key at https://app.sendgrid.com/settings/api_keys
# Minimum scope: Mail Send
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
# Must be a verified sender in your SendGrid account
SENDGRID_FROM_EMAIL="noreply@agreements.hawaiidata.ai"

# ─── Twilio Verify ────────────────────────────────────────────────────────────
# Create a Verify Service at https://console.twilio.com/us1/verify/services
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
