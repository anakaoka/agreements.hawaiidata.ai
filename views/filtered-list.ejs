<%- include('layout-head', { pageTitle: status + ' ' + (type === 'quotes' ? 'Quotes' : 'Contracts'), activePage: 'dashboard' }) %>

<div class="page-header">
  <div>
    <a href="/dashboard" style="color:var(--primary);text-decoration:none;font-size:13px;">&larr; Back to Overview</a>
    <h2 style="margin-top:8px;"><%= status %> <%= type === 'quotes' ? 'Quotes' : 'Contracts' %></h2>
    <p style="color:var(--text-muted);font-size:14px;">Across all organizations</p>
  </div>
</div>

<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Title</th>
        <th>Organization</th>
        <th>Customer</th>
        <th>Status</th>
        <th><%= type === 'quotes' ? 'Total' : 'Value' %></th>
        <th>Updated</th>
      </tr>
    </thead>
    <tbody>
      <% if (items.length === 0) { %>
        <tr><td colspan="7"><div class="empty-state"><h3>No results</h3><p>No <%= type %> with status "<%= status %>"</p></div></td></tr>
      <% } else { items.forEach(function(item) { %>
      <tr style="cursor:pointer" onclick="window.location='/<%= type === 'quotes' ? 'quotes' : 'contracts' %>/<%= item.id %>'">
        <td><%= item.quote_number || item.contract_number %></td>
        <td><strong><%= item.title %></strong></td>
        <td><span style="color:var(--primary);font-size:13px;"><%= item.org_name || '-' %></span></td>
        <td><%= item.customer_name || '-' %><% if (item.customer_company) { %><br><small style="color:var(--text-muted)"><%= item.customer_company %></small><% } %></td>
        <td><span class="badge badge-<%= item.status.toLowerCase().replace(/ /g,'-').replace('ready-for-acceptance','ready') %>"><%= item.status %></span></td>
        <td>$<%= parseFloat(item.total || item.total_value || 0).toLocaleString('en-US', {minimumFractionDigits:2}) %></td>
        <td style="color:var(--text-muted);font-size:13px"><%= new Date(item.updated_at).toLocaleDateString() %></td>
      </tr>
      <% }); } %>
    </tbody>
  </table>
</div>

<%- include('layout-foot') %>
