<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error — Agreements</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family:'Inter',sans-serif; background:#f4f4f5; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; }
    .error-box { background:#fff; border-radius:12px; padding:48px; text-align:center; max-width:400px; box-shadow:0 2px 8px rgba(0,0,0,0.08); }
    h1 { color:#ef4444; font-size:24px; margin-bottom:12px; }
    p { color:#64748b; font-size:15px; line-height:1.6; }
  </style>
</head>
<body>
  <div class="error-box">
    <h1>Oops</h1>
    <p><%= message %></p>
  </div>
</body>
</html>
