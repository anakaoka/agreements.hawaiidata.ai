<%- include('layout-head', { pageTitle: editUser ? 'Edit User' : 'New User', activePage: 'admin' }) %>

<div class="page-header">
  <h2><%= editUser ? 'Edit User' : 'Create New User' %></h2>
</div>

<div class="card" style="max-width:600px">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="POST" action="<%= editUser ? '/admin/users/' + editUser.id : '/admin/users' %>">
    <div class="form-group"><label>Full Name</label><input name="full_name" class="form-control" value="<%= editUser ? editUser.full_name : '' %>" required></div>
    <div class="form-group"><label>Email</label><input name="email" type="email" class="form-control" value="<%= editUser ? editUser.email : '' %>" required></div>
    <div class="form-group"><label>Password<%= editUser ? ' (leave blank to keep current)' : '' %></label><input name="password" type="password" class="form-control" <%= editUser ? '' : 'required' %>></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div class="form-group">
        <label>Role</label>
        <select name="role" class="form-control">
          <option value="customer" <%= editUser && editUser.role === 'customer' ? 'selected' : '' %>>Customer</option>
          <option value="editor" <%= editUser && editUser.role === 'editor' ? 'selected' : '' %>>Editor</option>
          <option value="domain_admin" <%= editUser && editUser.role === 'domain_admin' ? 'selected' : '' %>>Domain Admin</option>
        </select>
      </div>
      <div class="form-group"><label>Company</label><input name="company" class="form-control" value="<%= editUser ? editUser.company || '' : '' %>"></div>
    </div>
    <div class="form-group"><label>Phone</label><input name="phone" class="form-control" value="<%= editUser ? editUser.phone || '' : '' %>"></div>
    <% if (editUser) { %>
    <div class="form-group"><label><input type="checkbox" name="is_active" <%= editUser.is_active ? 'checked' : '' %>> Active</label></div>
    <% } %>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <a href="/admin" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary"><%= editUser ? 'Update' : 'Create' %> User</button>
    </div>
  </form>
</div>

<%- include('layout-foot') %>
