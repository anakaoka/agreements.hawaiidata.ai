# Shared database
DATABASE_URL="postgresql://user:password@localhost:5432/agreements"

# Original Express app
SESSION_SECRET="replace-with-random-session-secret"
PORT=3000
NODE_ENV=production
BASE_URL="https://agreements.hawaiidata.ai"

# Next.js rebuild
NEXTAUTH_SECRET="replace-with-random-nextauth-secret"
NEXTAUTH_URL="https://agreements.hawaiidata.ai"

# SendGrid, used by both apps
SENDGRID_API_KEY="replace-with-sendgrid-api-key"
SENDGRID_FROM="agreements@example.com"
SENDGRID_FROM_EMAIL="agreements@example.com"

# SMS verification
# Express app uses TWILIO_FROM for direct SMS messages.
# Next.js rebuild uses TWILIO_VERIFY_SERVICE_SID for Twilio Verify.
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM="replace-with-twilio-phone-number"
TWILIO_VERIFY_SERVICE_SID="replace-with-twilio-verify-service-sid"

# Optional Express OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://agreements.hawaiidata.ai/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=https://agreements.hawaiidata.ai/auth/microsoft/callback
